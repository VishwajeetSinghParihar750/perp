#
# Quick start:
#   1. cd packages/db && docker compose up -d
#   2. cd packages/db && bunx prisma migrate deploy
#   3. Replace JWT_SECRET_KEY and PRICE_UPDATES_WEBSOCKET_BACKEND_URL if needed
#   4. bun run dev (from repo root)

REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/perp

PORT_HTTP=3001
PORT_WS=3000
JWT_SECRET_KEY=dev-jwt-secret-change-me
REDIS_ENGINE_SEND_STREAM_NAME=engine:input
REDIS_ENGINE_RECEIVE_STREAM_NAME=backend:responses

REDIS_ENGINE_STREAM=engine:input
DB_POLLER_REDIS_STREAM=dbpoller:events
PRICE_UPDATES_WEBSOCKET_BACKEND_URL=wss://fstream.binance.com/ws

VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3000
